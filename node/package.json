{
  "name": "happy-wakey-lambdas-node-runtime",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "bundle": "rollup --config rollup.config.mjs",
    "bundle:deno": "deno compile --allow-env --output dist/handler-deno handler.mjs",
    "bundle:bun": "bun build handler.mjs --compile --outfile dist/handler-bun"
  },
  "devDependencies": {
    "rollup": "^4.0.0"
  }
}
